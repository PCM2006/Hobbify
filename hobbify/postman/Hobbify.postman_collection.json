{
  "info": {
    "name": "Hobbify · Autenticación y perfil de empresa",
    "description": "Pruebas locales de HU-02 y HU-12. Ejecuta todas las solicitudes en su orden. Cada ejecución registra dos cuentas ficticias con correos únicos y actualiza el perfil de la empresa de prueba. Postman conserva la cookie de sesión y los scripts guardan el token CSRF cuando se renueva.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "clavePrueba",
      "value": "Hobbify-Prueba-2026!",
      "type": "string"
    },
    {
      "key": "correoPersonal",
      "value": "",
      "type": "string"
    },
    {
      "key": "correoEmpresa",
      "value": "",
      "type": "string"
    },
    {
      "key": "empresaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "csrfToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 · Obtener CSRF y preparar los datos de prueba",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/csrf"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('correoPersonal', 'postman-personal-' + id + '@example.test');",
              "pm.collectionVariables.set('correoEmpresa', 'postman-empresa-' + id + '@example.test');",
              "pm.collectionVariables.unset('empresaId');",
              "pm.collectionVariables.unset('csrfToken');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "if (pm.response.code === 200) {",
              "    pm.test(\"Guardar token CSRF de la sesión\", function () {",
              "        const csrf = pm.response.json();",
              "        pm.expect(csrf.headerName).to.eql('X-CSRF-TOKEN');",
              "        pm.expect(csrf.token).to.be.a('string').and.not.be.empty;",
              "        pm.collectionVariables.set('csrfToken', csrf.token);",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · Registrar cuenta personal",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrfToken}}"
          }
        ],
        "url": "{{baseUrl}}/auth/registro",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Persona de Postman\",\n  \"correo\": \"{{correoPersonal}}\",\n  \"contrasena\": \"{{clavePrueba}}\",\n  \"tipo\": \"USUARIO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "if (pm.response.code === 201) {",
              "    pm.test(\"Datos de la cuenta USUARIO\", function () {",
              "        const cuenta = pm.response.json();",
              "        pm.expect(cuenta.tipo).to.eql('USUARIO');",
              "        pm.expect(cuenta.correo).to.eql(pm.collectionVariables.get('correoPersonal'));",
              "        pm.expect(cuenta).not.to.have.property('contrasena');",
              "        pm.expect(cuenta).not.to.have.property('hash');",
              "    });",
              "}"
            ]
          }
        }
      ]
    },
